{
    "schema_version": 1,
    "repository": {
        "full_name": "yurirocha15/mcp-cpp-sdk-release-control",
        "visibility": "public",
        "default_branch": "main",
        "issues": false,
        "projects": false,
        "wiki": false,
        "discussions": false,
        "pages": false,
        "secret_scanning": true,
        "push_protection": true,
        "immutable_releases": true,
        "retention_days": 90
    },
    "actions": {
        "default_workflow_permissions": "read",
        "can_approve_pull_requests": false,
        "github_hosted_runners_only": true,
        "require_full_sha": true,
        "allowed_actions": {
            "actions/checkout": "3d3c42e5aac5ba805825da76410c181273ba90b1",
            "actions/create-github-app-token": "64ab729a6294000f5aa4a4bc0b73d1f32bc45510",
            "actions/download-artifact": "9000827ccba6bdab643e8b6fd33ac0654aef8333",
            "actions/upload-artifact": "cf430e030ddbb5b0abf93d22962f4752f3646cd9"
        },
        "allowed_workflows": {
            "ci.yml": [
                "push",
                "pull_request"
            ],
            "conan-center-pr.yml": [
                "workflow_dispatch"
            ]
        }
    },
    "main_ruleset": {
        "enforcement": "active",
        "pull_request_required": true,
        "required_approvals": 0,
        "signed_commits": true,
        "linear_history": true,
        "conversation_resolution": true,
        "deletion_blocked": true,
        "force_push_blocked": true,
        "bypass_actors": [],
        "required_checks": [
            "actionlint",
            "release-control-policy",
            "publisher-unit-tests",
            "secret-scan"
        ]
    },
    "control_tag_ruleset": {
        "tag": "release-control-v3",
        "enforcement": "active",
        "update_blocked": true,
        "deletion_blocked": true,
        "bypass_actors": []
    },
    "control_release": {
        "tag": "release-control-v3",
        "draft": false,
        "prerelease": false,
        "immutable": true,
        "asset_inventory": []
    },
    "environment": {
        "name": "conan-fork-push",
        "required_reviewer_count": 1,
        "prevent_self_review": false,
        "administrator_bypass": false,
        "deployment_tag": "release-control-v3",
        "secrets": [
            "CONAN_FORK_APP_PRIVATE_KEY"
        ],
        "variables": [
            "CONAN_FORK_APP_CLIENT_ID"
        ]
    },
    "publisher_app": {
        "installation_repositories": [
            "yurirocha15/conan-center-index"
        ],
        "permissions": {
            "metadata": "read",
            "contents": "write",
            "all_other_permissions": "none"
        }
    },
    "repository_variables": [
        "CONAN_CENTER_FORK_REPOSITORY_ID",
        "CONAN_CENTER_FORK_OWNER_ID",
        "CONAN_CENTER_UPSTREAM_REPOSITORY_ID",
        "SOURCE_REPOSITORY_ID",
        "SOURCE_OWNER_ID",
        "SOURCE_SIGNING_PRIMARY_FINGERPRINT",
        "SOURCE_TAG_SIGNING_SUBKEY_FINGERPRINT",
        "SOURCE_ARTIFACT_SIGNING_SUBKEY_FINGERPRINT"
    ],
    "workflow_constants": {
        "source_repository": "yurirocha15/mcp-cpp-sdk",
        "fork_repository": "yurirocha15/conan-center-index",
        "upstream_repository": "conan-io/conan-center-index",
        "upstream_base_branch": "master"
    }
}
